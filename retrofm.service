[Unit]
Description=RetroFM Web UI and PiFmAdv Playback Service
After=network.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/retrofm/src
ExecStart=/usr/bin/node server.js
Restart=on-failure
RestartSec=5s
User=root
Environment=NODE_ENV=production

[Install]
WantedBy=multi-user.target
