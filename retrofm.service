[Unit]
Description=RetroFM Web UI and PiFmAdv Playback Service
After=network.target hostapd.service dnsmasq.service
Wants=network-online.target hostapd.service dnsmasq.service

[Service]
Type=simple
WorkingDirectory=/opt/retrofm/src
ExecStart=/usr/bin/node server.js
Restart=on-failure
RestartSec=5s
User=root
Environment=NODE_ENV=production
Environment=PORT=80

[Install]
WantedBy=multi-user.target
